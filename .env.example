FLOW_ENV=development
FLOW_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+psycopg://flow:flow_dev_only@localhost:5432/flow
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=flow
S3_ACCESS_KEY=flow
S3_SECRET_KEY=flow_dev_only
# S3 客户端默认绕过系统/环境代理（boto3 会拾取 macOS 系统代理，本机代理未运行时
# 指向 MinIO 的请求会挂起）。确需经代理访问外部对象存储时设为 true。
S3_USE_SYSTEM_PROXY=false
# Browser calls must use the same-origin /api/v1 proxy.
FLOW_API_INTERNAL_URL=http://localhost:8000
# Set AUTH_TOKEN identically in the API and Web server environments.
# Set both values to enable protected single-user Web access; blank = local development.
AUTH_TOKEN=
FLOW_WEB_PASSWORD=

# Required behind a reverse proxy: canonical HTTPS origin, e.g. https://flow.example.com
FLOW_WEB_ORIGIN=
