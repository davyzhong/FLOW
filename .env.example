FLOW_ENV=development
FLOW_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+psycopg://flow:flow_dev_only@localhost:5432/flow
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=flow
S3_ACCESS_KEY=flow
S3_SECRET_KEY=flow_dev_only
# S3 客户端默认绕过系统/环境代理（boto3 会拾取 macOS 系统代理，本机代理未运行时
# 指向 MinIO 的请求会挂起）。确需经代理访问外部对象存储时设为 true。
S3_USE_SYSTEM_PROXY=false
# Browser calls must use the same-origin /api/v1 proxy.
FLOW_API_INTERNAL_URL=http://localhost:8000
# Set AUTH_TOKEN identically in the API and Web server environments.
# Set both values to enable protected single-user Web access; blank = local development.
AUTH_TOKEN=
FLOW_WEB_PASSWORD=
# S01 §2.2 development 模式：无 AUTH_TOKEN 时 API 按 dev principal 放行，
# 该 actor 必须在 DB 有一条 active RoleBinding（make stack-up / seed_dev_principal.py 幂等补齐）。
FLOW_DEV_ACTOR_ID=flow-dev-bp
# S01 §3.2 legacy 冻结身份（AUTH_TOKEN 启用时必填；DB 需精确匹配的 service_account binding）
FLOW_LEGACY_ACTOR_ID=
FLOW_LEGACY_ENTERPRISE_ID=
# S01 §3.1 推荐路径：identity bindings（web 代理 analyst token；JSON 数组）
# 示例：FLOW_IDENTITY_BINDINGS_JSON=[{"token_sha256":"<sha256>","actor_id":"web-analyst","role":"analyst","enterprise_id":"00000000-0000-0000-0000-00000000d001","is_service_account":false}]
FLOW_IDENTITY_BINDINGS_JSON=
# Route inventory TSV 覆盖（容器外一般不需要）
FLOW_ROUTE_INVENTORY_TSV=

# Required behind a reverse proxy: canonical HTTPS origin, e.g. https://flow.example.com
FLOW_WEB_ORIGIN=
