FLOW_ENV=development
FLOW_TIMEZONE=Asia/Shanghai
# 默认数据目录为 ~/.flow；其中 flow.sqlite3 保存关系数据，objects/ 保存原始文件。
# 如需更换目录，取消注释并设置 FLOW_DATA_DIR=/your/local/path。
# FLOW_DATA_DIR=/your/local/path
# 浏览器请求通过同源 /api/v1 代理转发。
FLOW_API_INTERNAL_URL=http://localhost:8000
# API 与 Web 服务必须配置相同的 AUTH_TOKEN。
# 同时设置这两个值可启用单用户 Web 保护；留空表示本机开发模式。
AUTH_TOKEN=
FLOW_WEB_PASSWORD=
# S01 §2.2 development 模式：无 AUTH_TOKEN 时使用本机初始化命令创建 dev principal。
FLOW_DEV_ACTOR_ID=flow-dev-bp
# S01 §3.2 legacy 冻结身份（AUTH_TOKEN 启用时必填；DB 需精确匹配的 service_account binding）
FLOW_LEGACY_ACTOR_ID=
FLOW_LEGACY_ENTERPRISE_ID=
# S01 §3.1 推荐路径：identity bindings（web 代理 analyst token；JSON 数组）
# 示例：FLOW_IDENTITY_BINDINGS_JSON=[{"token_sha256":"<sha256>","actor_id":"web-analyst","role":"analyst","enterprise_id":"00000000-0000-0000-0000-00000000d001","is_service_account":false}]
FLOW_IDENTITY_BINDINGS_JSON=
# Route inventory TSV 覆盖（容器外一般不需要）
FLOW_ROUTE_INVENTORY_TSV=

# 仅反向代理部署需要：规范 HTTPS 来源，例如 https://flow.example.com。
FLOW_WEB_ORIGIN=
